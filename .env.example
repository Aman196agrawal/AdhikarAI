# ---------------------------------------------------------------------------
# AdhikarAI environment variables. Copy to `.env` and fill in.
# No secrets are committed to this repository.
# ---------------------------------------------------------------------------

# Postgres connection string.
#   local  -> matches docker-compose.yml (host port 5433)
#   prod   -> Neon pooled connection string
DATABASE_URL="postgresql://adhikarai:adhikarai_dev@localhost:5433/adhikarai?schema=public"

# Separate DATABASE used by the test suite (created by `npm run db:test`).
# The scenario tests clear citizen data, so they must not share a database
# with your demo personas. It must be a separate database rather than a
# schema: Prisma 7 driver adapters ignore the "?schema=" parameter at runtime.
TEST_DATABASE_URL="postgresql://adhikarai:adhikarai_dev@localhost:5433/adhikarai_test"

# Which LLM implementation to use.
#   "stub"   -> deterministic fixtures; the whole loop runs with no API calls.
#               Used by every test and by dev without a key.
#   "gemini" -> real Google Gemini calls; requires GEMINI_API_KEY.
LLM_PROVIDER="stub"
GEMINI_API_KEY=""

# Shared secret for the monitoring tick endpoint. The external cron
# (GitHub Actions, 5-minute schedule) sends it as `Authorization: Bearer <value>`.
CRON_SECRET=""

# "true" exposes the labelled demo console and the simulated-clock controls.
# Must be "false" in any environment holding real citizen data.
DEMO_MODE="true"
